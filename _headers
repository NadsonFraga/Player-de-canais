# Global Security Headers & Content Security Policy (D6)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://image.tmdb.org https://images.metahub.space https://m.media-amazon.com https:; media-src 'self' blob: http: https:; connect-src 'self' blob: https://api.themoviedb.org https://api.aniskip.com https://api.jikan.moe https:; frame-src 'self' https://embedplayer2.xyz https://superflixapi.top https://mgeb.top https://*.mgeb.top https://*.blogger.com https://www.youtube.com https:; frame-ancestors 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self';

# Cloudflare Pages Cache Rules for Dynamic Scraping JSON
/data/proximos_jogos.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/data/canais.json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

# Code (JS and CSS): the browser must ask whether the file changed before using its copy (a cheap 304 when it did not).
# Together with the single ?v= stamp from tools/bump_version.py this keeps old and new modules from ever being mixed.
# Rules must not overlap: Cloudflare joins the values when two rules set the same header.
/assets/js/*
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

# Images (logos, favicons): they rarely change, keep them cached
/assets/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

