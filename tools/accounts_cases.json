{
  "about": "Account API cases run against functions/api/account/[[path]].js (tools/accounts_api_check.mjs) and tools/local_accounts.py (tools/test_accounts_api.py). Each device has its own cookie and IP. Strings like {code1} are values saved by earlier steps. 'origin': same (default), other or none; 'header': false sends no X-Tvzinha-Request; 'advance': milliseconds added to the clock before the step.",
  "devices": { "A": "198.51.100.1", "B": "198.51.100.2" },
  "steps": [
    { "name": "nickname too short", "device": "A", "path": "register", "body": { "nickname": "ab", "password": "cinema2026" }, "expect": { "status": 400, "error": "nickname_short" } },
    { "name": "nickname with a space", "device": "A", "path": "register", "body": { "nickname": "nad son", "password": "cinema2026" }, "expect": { "status": 400, "error": "nickname_chars" } },
    { "name": "password without a number", "device": "A", "path": "register", "body": { "nickname": "Nadson", "password": "abcdefgh" }, "expect": { "status": 400, "error": "password_number" } },
    { "name": "password without a letter", "device": "A", "path": "register", "body": { "nickname": "Nadson", "password": "12345678" }, "expect": { "status": 400, "error": "password_letter" } },
    { "name": "password too short", "device": "A", "path": "register", "body": { "nickname": "Nadson", "password": "abc12" }, "expect": { "status": 400, "error": "password_short" } },
    { "name": "password equal to the nickname", "device": "A", "path": "register", "body": { "nickname": "Nadson123", "password": "nadson123" }, "expect": { "status": 400, "error": "password_is_nickname" } },
    { "name": "write without the custom header", "device": "A", "path": "register", "header": false, "body": { "nickname": "Nadson", "password": "cinema2026" }, "expect": { "status": 403, "error": "origin_forbidden" } },
    { "name": "write from another site", "device": "A", "path": "register", "origin": "other", "body": { "nickname": "Nadson", "password": "cinema2026" }, "expect": { "status": 403, "error": "origin_forbidden" } },
    { "name": "create the account", "device": "A", "path": "register", "body": { "nickname": "Nadson", "password": "cinema2026" },
      "expect": { "status": 201, "cookie": "set", "has": ["recoveryCode"], "json": { "account.nickname": "Nadson", "profiles.length": 1, "profiles.0.name": "Nadson" } }, "save": { "code1": "recoveryCode" } },
    { "name": "same nickname in other case", "device": "B", "path": "register", "body": { "nickname": "nadson", "password": "outra2026" }, "expect": { "status": 409, "error": "nickname_taken" } },
    { "name": "signed in on A", "device": "A", "method": "GET", "path": "me", "origin": "none", "expect": { "status": 200, "json": { "account.nickname": "Nadson" } } },
    { "name": "signed out on B", "device": "B", "method": "GET", "path": "me", "origin": "none", "expect": { "status": 401, "error": "not_signed_in" } },
    { "name": "wrong password 1", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "wrong password 2", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "wrong password 3", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "wrong password 4", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "wrong password 5", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "sixth try blocked, even with the right password", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "cinema2026" }, "expect": { "status": 429, "error": "too_many_attempts", "has": ["retryAfter"] } },
    { "name": "after 16 minutes it works", "device": "B", "advance": 960000, "path": "login", "body": { "nickname": "NADSON", "password": "cinema2026" }, "expect": { "status": 200, "cookie": "set", "json": { "account.nickname": "Nadson" } } },
    { "name": "change password with the wrong current one", "device": "B", "path": "password", "body": { "currentPassword": "errada2026", "newPassword": "pipoca2027" }, "expect": { "status": 401, "error": "wrong_password" } },
    { "name": "change password", "device": "B", "path": "password", "body": { "currentPassword": "cinema2026", "newPassword": "pipoca2027" }, "expect": { "status": 200 } },
    { "name": "the other device was signed out", "device": "A", "method": "GET", "path": "me", "origin": "none", "expect": { "status": 401, "error": "not_signed_in", "cookie": "cleared" } },
    { "name": "old password no longer works", "device": "A", "path": "login", "body": { "nickname": "nadson", "password": "cinema2026" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "new password works", "device": "A", "path": "login", "body": { "nickname": "nadson", "password": "pipoca2027" }, "expect": { "status": 200, "cookie": "set" } },
    { "name": "a new recovery code", "device": "A", "path": "recovery-code", "body": { "password": "pipoca2027" }, "expect": { "status": 200, "has": ["recoveryCode"] }, "save": { "code2": "recoveryCode" } },
    { "name": "the old recovery code no longer works", "device": "B", "path": "recover", "body": { "nickname": "nadson", "recoveryCode": "{code1}", "newPassword": "filme2028" }, "expect": { "status": 401, "error": "wrong_recovery" } },
    { "name": "recover with the new code (lower case, no dashes)", "device": "B", "path": "recover", "body": { "nickname": "nadson", "recoveryCode": "{code2:loose}", "newPassword": "filme2028" },
      "expect": { "status": 200, "cookie": "set", "has": ["recoveryCode"], "json": { "account.nickname": "Nadson" } }, "save": { "code3": "recoveryCode" } },
    { "name": "recovering signed out the other devices", "device": "A", "method": "GET", "path": "me", "origin": "none", "expect": { "status": 401, "error": "not_signed_in" } },
    { "name": "sign out", "device": "B", "path": "logout", "body": {}, "expect": { "status": 200, "cookie": "cleared" } },
    { "name": "signed out", "device": "B", "method": "GET", "path": "me", "origin": "none", "expect": { "status": 401, "error": "not_signed_in" } },
    { "name": "sign in again", "device": "B", "path": "login", "body": { "nickname": "nadson", "password": "filme2028" }, "expect": { "status": 200, "cookie": "set" } },
    { "name": "delete with the wrong password", "device": "B", "path": "delete", "body": { "password": "errada2026" }, "expect": { "status": 401, "error": "wrong_password" } },
    { "name": "delete the account", "device": "B", "path": "delete", "body": { "password": "filme2028" }, "expect": { "status": 200, "cookie": "cleared" } },
    { "name": "the account is gone", "device": "A", "path": "login", "body": { "nickname": "nadson", "password": "filme2028" }, "expect": { "status": 401, "error": "wrong_credentials" } },
    { "name": "the nickname is free again", "device": "A", "path": "register", "body": { "nickname": "Nadson", "password": "cinema2026" }, "expect": { "status": 201, "cookie": "set" } },
    { "name": "unknown route", "device": "A", "path": "nothing", "body": {}, "expect": { "status": 404, "error": "not_found" } },
    { "name": "me only answers GET", "device": "A", "path": "me", "body": {}, "expect": { "status": 405, "error": "method_not_allowed" } },
    { "name": "register only answers POST", "device": "A", "method": "GET", "path": "register", "origin": "none", "expect": { "status": 405, "error": "method_not_allowed" } }
  ]
}
